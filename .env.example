# Copy this file to .env and fill in the values (.env is gitignored)

# Contentful
PUBLIC_cSPACE=
PUBLIC_cACCESS_TOKEN=

# Google Analytics
PUBLIC_GA_ID=

# Post feed URLs
PUBLIC_POSTS_AVATARS_100=
PUBLIC_POSTS_AVATARS_200=
PUBLIC_POSTS_AVATARS_400=
PUBLIC_POSTS_PSDS=
PUBLIC_POSTS_RENDERS=
PUBLIC_POSTS_TEMPLATES=
PUBLIC_POSTS_CUSTOM=
PUBLIC_POSTS_TUTORIALS=

# NEOCITIES
NEOCITIES_API_TOKEN=

# Remark42 comments (shared server with Vizune Reviews).
# Leave the host empty to show "Comments are coming soon".
PUBLIC_REMARK42_HOST=
# Must be listed in SITE on the Remark42 server (defaults to "design")
# PUBLIC_REMARK42_SITE_ID=design
# Public address of this site, so each post keeps one comment thread
# even when you test locally
PUBLIC_SITE_URL=
