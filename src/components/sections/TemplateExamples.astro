---
import Sparkle from '@/components/ornament/Sparkle.astro';

// Cards for the custom templates I've made, each opening its full-page
// screenshot in the shared preview modal (see PreviewModal.astro).
export type TemplateExample = {
  title: string;
  date: string;
  techStack: string;
  description?: string;
  thumbnail?: string;
  screenshot?: { src: string; width?: number; height?: number };
};

interface Props {
  examples: TemplateExample[];
}

const { examples } = Astro.props as Props;
---

<div class="Examples" data-examples>
  {examples.map((example) => (
    <article class="Card Card--hover Examples-card">
      <button
        type="button"
        class="Examples-thumb Card-media"
        data-preview
        data-title={example.title}
        data-subtitle={example.techStack}
        data-crop="0.62"
        data-ga-event="template_click"
        data-ga-location="request_page"
        data-src={example.screenshot?.src}
        data-width={example.screenshot?.width}
        data-height={example.screenshot?.height}
        disabled={!example.screenshot}
        aria-label={`Preview ${example.title}`}
      >
        {example.thumbnail && <img src={example.thumbnail} alt="" loading="lazy" decoding="async" />}
      </button>

      <div class="Examples-body">
        {example.techStack && (
          <p class="Kicker">
            <Sparkle class="Kicker-star" />
            {example.techStack}
          </p>
        )}
        <h3 class="Card-title Examples-title">{example.title}</h3>
        {example.date && <p class="Card-text Examples-date">{example.date}</p>}
        {example.description && <p class="Card-text Examples-desc">{example.description}</p>}

        <div class="Examples-actions">
          {example.screenshot && (
            <button
              type="button"
              class="Btn Btn--small"
              data-preview
              data-title={example.title}
              data-subtitle={example.techStack}
              data-crop="0.62"
              data-ga-event="template_click"
              data-ga-location="request_page"
              data-src={example.screenshot.src}
              data-width={example.screenshot.width}
              data-height={example.screenshot.height}
            >
              Preview
            </button>
          )}
        </div>
      </div>
    </article>
  ))}
</div>

<style>
  .Examples {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 20rem));
    justify-content: center;
    gap: 1.5rem;
  }

  .Examples-card {
    padding: .75rem;
  }

  .Examples-thumb {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    padding: 0;
    cursor: zoom-in;
  }

  .Examples-thumb:disabled {
    cursor: default;
  }

  .Examples-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1rem .75rem .5rem;
  }

  .Examples-title {
    margin-top: .5rem;
    font-size: 1.4rem;
  }

  .Examples-date {
    margin-top: .25rem;
  }

  .Examples-desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
    margin-top: .75rem;
  }

  .Examples-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem;
    margin-top: auto;
    padding-top: 1.1rem;
  }
</style>
