---
import Sparkle from '@/components/ornament/Sparkle.astro';

// Cards for the custom templates I've made, each opening its full-page
// screenshot in the shared preview modal (see PreviewModal.astro).
export type TemplateExample = {
  title: string;
  date: string;
  techStack: string;
  description?: string;
  thumbnail?: string;
  screenshot?: { src: string; width?: number; height?: number };
};

interface Props {
  examples: TemplateExample[];
}

const { examples } = Astro.props as Props;
---

<div class="Examples" data-examples>
  {examples.map((example) => (
    <article class="Card Card--hover p-3">
      <button
        type="button"
        class="Examples-thumb Card-media aspect-square"
        data-preview
        data-title={example.title}
        data-subtitle={example.techStack}
        data-crop="0.62"
        data-ga-event="template_click"
        data-ga-location="request_page"
        data-src={example.screenshot?.src}
        data-width={example.screenshot?.width}
        data-height={example.screenshot?.height}
        disabled={!example.screenshot}
        aria-label={`Preview ${example.title}`}
      >
        {example.thumbnail && <img src={example.thumbnail} alt="" loading="lazy" decoding="async" />}
      </button>

      <div class="px-3 pt-4 pb-2 flex flex-col flex-1">
        {example.techStack && (
          <p class="Kicker">
            <Sparkle class="Kicker-star" />
            {example.techStack}
          </p>
        )}
        <h3 class="Card-title mt-2 text-[1.4rem]">{example.title}</h3>
        {example.date && <p class="Card-text mt-1">{example.date}</p>}
        {example.description && <p class="Card-text mt-3 line-clamp-4">{example.description}</p>}

        <div class="Examples-actions">
          {example.screenshot && (
            <button
              type="button"
              class="Btn Btn--small"
              data-preview
              data-title={example.title}
              data-subtitle={example.techStack}
              data-crop="0.62"
              data-ga-event="template_click"
              data-ga-location="request_page"
              data-src={example.screenshot.src}
              data-width={example.screenshot.width}
              data-height={example.screenshot.height}
            >
              Preview
            </button>
          )}
        </div>
      </div>
    </article>
  ))}
</div>

<style>
  .Examples {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 20rem));
    justify-content: center;
    gap: 1.5rem;
  }

  .Examples-thumb {
    display: block;
    width: 100%;
    padding: 0;
    cursor: zoom-in;
  }

  .Examples-thumb:disabled {
    cursor: default;
  }

  .Examples-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem;
    margin-top: auto;
    padding-top: 1.1rem;
  }
</style>
