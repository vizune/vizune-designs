---
type TemplatePost = {
  sys: { id: string };
  fields: {
    title?: string;
    banner?: { sys?: { id?: string } };
    downloadUrl?: string;
    publishDate?: string;
    techStack?: string;
    category?: string;
    series?: string;
    character?: string;
    demoUrl?: string;
    repoUrl?: string;
  };
};

type Asset = {
  sys: { id: string };
  fields?: {
    file?: { url?: string };
    title?: string;
    description?: string;
  };
};

interface Props {
  post: TemplatePost;
  assetsById: Map<string, Asset>;
  index: number;
}

const { post, assetsById, index } = Astro.props as Props;

function toAbsoluteContentfulUrl(url?: string) {
  if (!url) return '';
  return url.startsWith('//') ? `https:${url}` : url;
}

const bannerId = post.fields.banner?.sys?.id;
const asset = bannerId ? assetsById.get(bannerId) : undefined;
const imgUrl = toAbsoluteContentfulUrl(asset?.fields?.file?.url);

const title = post.fields.title ?? 'Untitled template';
const alt = asset?.fields?.description || asset?.fields?.title || title;
---

<article
  data-card
  data-index={index}
  data-title={title}
  data-publish-date={post.fields.publishDate ?? ''}
  data-tech-stack={post.fields.techStack ?? ''}
  data-category={post.fields.category ?? ''}
  data-series={post.fields.series ?? ''}
  data-character={post.fields.character ?? ''}
  data-demo-url={post.fields.demoUrl ?? ''}
  data-repo-url={post.fields.repoUrl ?? ''}
  data-download-url={post.fields.downloadUrl ?? ''}
  class="tarot-card absolute left-1/2 top-1/2 w-[180px] sm:w-[230px] md:w-[262px] aspect-[0.62]"
>
  <div class="tarot-frame">
    {imgUrl ? (
      <img
        src={imgUrl}
        alt={alt}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover"
      />
    ) : (
      <div class="h-full w-full flex items-center justify-center text-lavender/60 text-sm">
        No banner
      </div>
    )}

    <div class="tarot-title">
      <span class="tarot-star" aria-hidden="true">&#10022;</span>
      <h3>{title}</h3>
    </div>
  </div>
</article>
<style>
.tarot-card {
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, -50%) scale(0.85);
  transition:
    transform 0.45s cubic-bezier(.22,1,.36,1),
    opacity 0.35s ease,
    filter 0.35s ease;
}

/* Gilded tarot frame: lavender rim, inset night-blue mat and corner brackets */
.tarot-frame {
  position: relative;
  height: 100%;
  padding: 6px;
  overflow: hidden;
  background: linear-gradient(180deg, #1d1840, #07061a);
  border: 1px solid rgba(201, 184, 255, .6);
  box-shadow: inset 0 0 0 5px #07061a, inset 0 0 0 6px rgba(201, 184, 255, .3), 0 20px 50px rgba(27, 24, 48, .45);
}

.tarot-frame::before {
  content: '';
  position: absolute;
  inset: 12px;
  z-index: 2;
  pointer-events: none;
  --c: rgba(255, 255, 255, .8);
  background:
    linear-gradient(var(--c), var(--c)) top left / 20px 1px,
    linear-gradient(var(--c), var(--c)) top left / 1px 20px,
    linear-gradient(var(--c), var(--c)) top right / 20px 1px,
    linear-gradient(var(--c), var(--c)) top right / 1px 20px,
    linear-gradient(var(--c), var(--c)) bottom left / 20px 1px,
    linear-gradient(var(--c), var(--c)) bottom left / 1px 20px,
    linear-gradient(var(--c), var(--c)) bottom right / 20px 1px,
    linear-gradient(var(--c), var(--c)) bottom right / 1px 20px;
  background-repeat: no-repeat;
}

.tarot-frame img {
  border: 1px solid rgba(201, 184, 255, .25);
}

.tarot-title {
  position: absolute;
  left: 6px;
  right: 6px;
  bottom: 6px;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: .2rem;
  padding: 2.25rem .75rem 1.1rem;
  text-align: center;
  background: linear-gradient(180deg, transparent, rgba(8, 6, 24, .85) 40%, rgba(8, 6, 24, .97));
}

.tarot-title h3 {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: clamp(1rem, 2.4vw, 1.35rem);
  line-height: 1.15;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: #fff;
  text-shadow: 0 0 12px rgba(167, 139, 255, .7);
}

.tarot-star {
  font-size: .65rem;
  color: var(--lavender);
}

.tarot-card.is-hidden {
  opacity: 0;
  pointer-events: none;
}

.tarot-card.is-left,
.tarot-card.is-right {
  cursor: pointer;
}

.tarot-card.is-left,
.tarot-card.is-center,
.tarot-card.is-right {
  opacity: 1;
  pointer-events: auto;
}

.tarot-card.is-left {
  transform: translate(calc(-50% - 220px), -50%) rotate(-10deg) scale(0.92);
  z-index: 1;
  filter: brightness(.75) saturate(.85);
}

.tarot-card.is-center {
  transform: translate(-50%, -54%) rotate(0deg) scale(1);
  z-index: 3;
  cursor: default;
}

.tarot-card.is-center .tarot-frame {
  box-shadow:
    inset 0 0 0 5px #07061a,
    inset 0 0 0 6px rgba(201, 184, 255, .3),
    0 0 0 1px rgba(201, 184, 255, .35),
    0 24px 60px rgba(27, 24, 48, .55),
    0 0 50px rgba(123, 92, 255, .45);
}

.tarot-card.is-right {
  transform: translate(calc(-50% + 220px), -50%) rotate(10deg) scale(0.92);
  z-index: 2;
  filter: brightness(.75) saturate(.85);
}

.tarot-card.is-center:hover {
  transform: translate(-50%, -56%) rotate(0deg) scale(1.03);
}

.tarot-card.is-left:hover {
  transform: translate(calc(-50% - 220px), -52%) rotate(-10deg) scale(0.95);
  filter: none;
}

.tarot-card.is-right:hover {
  transform: translate(calc(-50% + 220px), -52%) rotate(10deg) scale(0.95);
  filter: none;
}

@media (max-width: 767px) {
  .tarot-card.is-left {
    transform: translate(calc(-50% - 110px), -50%) rotate(-8deg) scale(0.88);
  }

  .tarot-card.is-left:hover {
    transform: translate(calc(-50% - 120px), -52%) rotate(-10deg) scale(0.95);
  }

  .tarot-card.is-center {
    transform: translate(-50%, -54%) rotate(0deg) scale(0.96);
  }

  .tarot-card.is-right {
    transform: translate(calc(-50% + 110px), -50%) rotate(8deg) scale(0.88);
  }

  .tarot-card.is-right:hover {
    transform: translate(calc(-50% + 120px), -52%) rotate(10deg) scale(0.95);
  }
}
</style>
