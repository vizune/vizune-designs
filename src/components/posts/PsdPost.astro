---
import Sparkle from '@/components/ornament/Sparkle.astro';

import Icon from '../ui/Icon.astro';

type PsdPost = {
  sys: { id: string };
  fields: {
    title?: string;
    fileSize?: string;
    url?: string;
    publishDate?: string;
    thumbnail?: { sys?: { id?: string } };
  };
};

type Asset = {
  sys: { id: string };
  fields?: {
    title?: string;
    description?: string;
    file?: { url?: string };
  };
};

interface Props {
  post: PsdPost;
  assetsById: Map<string, Asset>;
}

const { post, assetsById } = Astro.props as Props;

function toAbsoluteContentfulUrl(url?: string) {
  if (!url) return '';
  return url.startsWith('//') ? `https:${url}` : url;
}

const thumbId = post.fields.thumbnail?.sys?.id;
const asset = thumbId ? assetsById.get(thumbId) : undefined;

const imgUrl = toAbsoluteContentfulUrl(asset?.fields?.file?.url);

const title = post.fields.title ?? 'Untitled PSD';
const fileSize = post.fields.fileSize ?? '';
const downloadUrl = post.fields.url ?? '#';

const alt =
  asset?.fields?.description ||
  asset?.fields?.title ||
  title ||
  'PSD thumbnail';
  
const trackingId = `psd-${post.sys.id}`;
---

<article class="psd-card Card Card--hover p-3" id={trackingId}>
  <div class="Card-media flex items-center justify-center p-4 min-h-[182px] bg-[radial-gradient(ellipse_at_50%_0%,rgba(123,92,255,.25),transparent_70%)]">
    {imgUrl ? (
      <img
        src={imgUrl}
        alt={alt}
        loading="lazy"
        decoding="async"
        class="!w-auto !h-auto max-h-[150px] !object-contain"
      />
    ) : (
      <span class="text-sm text-lavender/60">No thumbnail</span>
    )}
  </div>

  <div class="flex flex-col flex-1 items-center text-center px-4 pt-5 pb-3">
    <p class="Kicker">
      <Sparkle class="Kicker-star" />
      PSD download
    </p>

    <h2 class="Card-title mt-2 flex-1">{title}</h2>

    <a
      href={downloadUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-psd-download
      data-psd-title={title}
      data-psd-size={fileSize}
      class="Btn Btn--small mt-5 w-full"
    >
      Download{fileSize ? ` (${fileSize})` : ''} <Icon name="newTab" title="Opens url in a new tab" size="small" />
    </a>
  </div>
</article>

<script is:inline define:vars={{ trackingId }}>
  const root = document.getElementById(trackingId);
  const link = root?.querySelector('[data-psd-download]');

  if (link && link.dataset.gaBound !== '1') {
    link.dataset.gaBound = '1';

    link.addEventListener('click', () => {
      const title = link.getAttribute('data-psd-title') || '';
      const fileSize = link.getAttribute('data-psd-size') || '';

      if (typeof window.gtag === 'function') {
        window.gtag('event', 'psd_download_click', {
          psd_title: title,
          file_size: fileSize,
          location: 'psd_page',
        });
      }
    });
  }
</script>
