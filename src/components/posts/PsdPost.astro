---
import Sparkle from '@/components/ornament/Sparkle.astro';

import Icon from '../ui/Icon.astro';

type PsdPost = {
  sys: { id: string };
  fields: {
    title?: string;
    fileSize?: string;
    url?: string;
    publishDate?: string;
    thumbnail?: { sys?: { id?: string } };
  };
};

type Asset = {
  sys: { id: string };
  fields?: {
    title?: string;
    description?: string;
    file?: { url?: string };
  };
};

interface Props {
  post: PsdPost;
  assetsById: Map<string, Asset>;
}

const { post, assetsById } = Astro.props as Props;

function toAbsoluteContentfulUrl(url?: string) {
  if (!url) return '';
  return url.startsWith('//') ? `https:${url}` : url;
}

const thumbId = post.fields.thumbnail?.sys?.id;
const asset = thumbId ? assetsById.get(thumbId) : undefined;

const imgUrl = toAbsoluteContentfulUrl(asset?.fields?.file?.url);

const title = post.fields.title ?? 'Untitled PSD';
const fileSize = post.fields.fileSize ?? '';
const downloadUrl = post.fields.url ?? '#';

const alt =
  asset?.fields?.description ||
  asset?.fields?.title ||
  title ||
  'PSD thumbnail';
  
const trackingId = `psd-${post.sys.id}`;
---

<article class="psd-card Card Card--hover Psd" id={trackingId}>
  <div class="Card-media Psd-media">
    {imgUrl ? (
      <img
        src={imgUrl}
        alt={alt}
        loading="lazy"
        decoding="async"
        class="Psd-img"
      />
    ) : (
      <span class="Psd-empty">No thumbnail</span>
    )}
  </div>

  <div class="Psd-body">
    <p class="Kicker">
      <Sparkle class="Kicker-star" />
      PSD download
    </p>

    <h2 class="Card-title Psd-title">{title}</h2>

    <a
      href={downloadUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-psd-download
      data-psd-title={title}
      data-psd-size={fileSize}
      class="Btn Btn--small Psd-download"
    >
      Download{fileSize ? ` (${fileSize})` : ''} <Icon name="newTab" title="Opens url in a new tab" size="small" />
    </a>
  </div>
</article>

<script is:inline define:vars={{ trackingId }}>
  const root = document.getElementById(trackingId);
  const link = root?.querySelector('[data-psd-download]');

  if (link && link.dataset.gaBound !== '1') {
    link.dataset.gaBound = '1';

    link.addEventListener('click', () => {
      const title = link.getAttribute('data-psd-title') || '';
      const fileSize = link.getAttribute('data-psd-size') || '';

      if (typeof window.gtag === 'function') {
        window.gtag('event', 'psd_download_click', {
          psd_title: title,
          file_size: fileSize,
          location: 'psd_page',
        });
      }
    });
  }
</script>

<style>
.Psd {
  padding: .75rem;
}

.Psd-media {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 182px;
  padding: 1rem;
  background-image: radial-gradient(ellipse at 50% 0%, rgba(123, 92, 255, .25), transparent 70%);
}

/* Show the whole thumbnail rather than cropping it like other card images */
.Psd-img {
  width: auto;
  height: auto;
  max-height: 150px;
  object-fit: contain;
}

.Psd-empty {
  font-size: .875rem;
  line-height: calc(1.25 / .875);
  color: rgba(201, 184, 255, .6);
}

.Psd-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  align-items: center;
  padding: 1.25rem 1rem .75rem;
  text-align: center;
}

.Psd-title {
  flex: 1;
  margin-top: .5rem;
}

.Psd-download {
  width: 100%;
  margin-top: 1.25rem;
}
</style>
