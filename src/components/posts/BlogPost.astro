---
import Sparkle from '@/components/ornament/Sparkle.astro';

type ArticlePost = {
  sys: { id: string };
  fields: {
    title?: string;
    slug?: string;
    publishDate?: string;
    description?: string;
    thumbnail?: { sys?: { id?: string } };
    banner?: { sys?: { id?: string } };
  };
};

type Asset = {
  sys: { id: string };
  fields?: {
    title?: string;
    description?: string;
    file?: { url?: string };
  };
};

interface Props {
  post: ArticlePost;
  assetsById: Map<string, Asset>;
  featured?: boolean;
}

const { post, assetsById, featured = false } = Astro.props as Props;

function toAbsoluteContentfulUrl(url?: string) {
  if (!url) return '';
  return url.startsWith('//') ? `https:${url}` : url;
}

function formatUkDate(iso?: string) {
  if (!iso) return '';
  const t = Date.parse(iso);
  if (!Number.isFinite(t)) return '';
  return new Date(t).toLocaleDateString('en-GB');
}

const thumbId = post.fields.thumbnail?.sys?.id;
const bannerId = post.fields.banner?.sys?.id;
const thumbAsset = thumbId ? assetsById.get(thumbId) : undefined;
const bannerAsset = bannerId ? assetsById.get(bannerId) : undefined;
const asset = featured ? bannerAsset : thumbAsset;
const imgUrl = toAbsoluteContentfulUrl(asset?.fields?.file?.url);

const title = post.fields.title ?? 'Untitled post';
const slug = post.fields.slug ?? '';
const description = post.fields.description ?? '';
const publishDate = formatUkDate(post.fields.publishDate);

const alt =
  asset?.fields?.description ||
  asset?.fields?.title ||
  title ||
  'Blog post thumbnail';
---

<a
  href={`/blog/${slug}/`}
  data-blog-click
  data-blog-title={title}
  data-blog-slug={slug}
  class:list={[
    'blog-card Card Card--hover Post',
    featured ? 'Post--featured' : 'Post--list',
  ]}
>
  <div class:list={['Card-media', featured ? 'Post-media--wide' : 'Post-media']}>
    {imgUrl ? (
      <img
        src={imgUrl}
        alt={alt}
        loading={featured ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <div class="Post-empty">
        No thumbnail
      </div>
    )}
  </div>

  <div class:list={['Post-body', { 'Post-body--wide': featured }]}>
    <p class="Kicker">
      <Sparkle class="Kicker-star" />
      {featured ? 'Latest news' : 'News'}
      {publishDate && <span class="Post-date">· {publishDate}</span>}
    </p>

    <h3 class:list={['Card-title Post-title', featured ? 'Post-title--wide' : 'Post-title--small']}>
      {title}
    </h3>

    {description ? (
      <p class:list={['Card-text Post-text', { 'Post-text--clamp': !featured }]}>
        {description}
      </p>
    ) : null}

    <span class="Card-more Post-more">Read more <span aria-hidden="true">›</span></span>
  </div>
</a>

<style>
.Post {
  padding: .75rem;
}

@media (min-width: 768px) {
  .Post--featured {
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    align-items: center;
  }
}

@media (min-width: 640px) {
  .Post--list {
    display: grid;
    grid-template-columns: 170px 1fr;
  }
}

.Post-media {
  aspect-ratio: 1;
}

.Post-media--wide {
  aspect-ratio: 1.92;
}

.Post-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: .875rem;
  line-height: calc(1.25 / .875);
  color: rgba(201, 184, 255, .6);
}

.Post-body {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 1.25rem 1rem .5rem;
}

@media (min-width: 640px) {
  .Post-body {
    padding: .75rem 1.25rem;
  }
}

.Post-body--wide {
  padding: 1.5rem 1rem .75rem;
}

@media (min-width: 768px) {
  .Post-body--wide {
    padding: 1.5rem 2rem;
  }
}

.Post-date {
  color: rgba(201, 184, 255, .7);
  letter-spacing: .16em;
}

.Post-title {
  margin-top: .5rem;
}

.Post-title--small {
  font-size: 1.45rem;
}

@media (min-width: 768px) {
  .Post-title--wide {
    font-size: 2.2rem;
  }
}

.Post-text {
  margin-top: .75rem;
}

.Post-text--clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}

.Post-more {
  margin-top: 1rem;
}
</style>
