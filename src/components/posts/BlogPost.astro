---
import Sparkle from '@/components/ornament/Sparkle.astro';

type ArticlePost = {
  sys: { id: string };
  fields: {
    title?: string;
    slug?: string;
    publishDate?: string;
    description?: string;
    thumbnail?: { sys?: { id?: string } };
    banner?: { sys?: { id?: string } };
  };
};

type Asset = {
  sys: { id: string };
  fields?: {
    title?: string;
    description?: string;
    file?: { url?: string };
  };
};

interface Props {
  post: ArticlePost;
  assetsById: Map<string, Asset>;
  featured?: boolean;
}

const { post, assetsById, featured = false } = Astro.props as Props;

function toAbsoluteContentfulUrl(url?: string) {
  if (!url) return '';
  return url.startsWith('//') ? `https:${url}` : url;
}

function formatUkDate(iso?: string) {
  if (!iso) return '';
  const t = Date.parse(iso);
  if (!Number.isFinite(t)) return '';
  return new Date(t).toLocaleDateString('en-GB');
}

const thumbId = post.fields.thumbnail?.sys?.id;
const bannerId = post.fields.banner?.sys?.id;
const thumbAsset = thumbId ? assetsById.get(thumbId) : undefined;
const bannerAsset = bannerId ? assetsById.get(bannerId) : undefined;
const asset = featured ? bannerAsset : thumbAsset;
const imgUrl = toAbsoluteContentfulUrl(asset?.fields?.file?.url);

const title = post.fields.title ?? 'Untitled post';
const slug = post.fields.slug ?? '';
const description = post.fields.description ?? '';
const publishDate = formatUkDate(post.fields.publishDate);

const alt =
  asset?.fields?.description ||
  asset?.fields?.title ||
  title ||
  'Blog post thumbnail';
---

<a
  href={`/blog/${slug}/`}
  data-blog-click
  data-blog-title={title}
  data-blog-slug={slug}
  class:list={[
    'blog-card Card Card--hover p-3',
    featured ? 'md:grid md:grid-cols-[1.45fr_1fr] md:items-center' : 'sm:grid sm:grid-cols-[170px_1fr]',
  ]}
>
  <div class:list={['Card-media', featured ? 'aspect-[1.92]' : 'aspect-square']}>
    {imgUrl ? (
      <img
        src={imgUrl}
        alt={alt}
        loading={featured ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <div class="h-full w-full flex items-center justify-center text-sm text-lavender/60">
        No thumbnail
      </div>
    )}
  </div>

  <div class:list={['flex flex-col justify-center', featured ? 'px-4 pt-6 pb-3 md:px-8 md:py-6' : 'px-4 pt-5 pb-2 sm:px-5 sm:py-3']}>
    <p class="Kicker">
      <Sparkle class="Kicker-star" />
      {featured ? 'Latest news' : 'News'}
      {publishDate && <span class="text-lavender/70 tracking-[.16em]">· {publishDate}</span>}
    </p>

    <h3 class:list={['Card-title mt-2', featured ? 'md:text-[2.2rem]' : 'text-[1.45rem]']}>
      {title}
    </h3>

    {description ? (
      <p class:list={['Card-text mt-3', { 'line-clamp-3': !featured }]}>
        {description}
      </p>
    ) : null}

    <span class="Card-more mt-4">Read more <span aria-hidden="true">›</span></span>
  </div>
</a>
