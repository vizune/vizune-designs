---
import Icon from '../ui/Icon.astro';

type Tag = { sys: { id: string } };

type RenderPost = {
  metadata: { tags?: Tag[] };
  sys: { id: string };
  fields: {
    title?: string;
    fileSize?: string;
    date?: string;
    imageDimensions?: string;
    thumbnail?: { sys?: { id?: string } };
    downloadUrl?: string;
    index?: number;
  };
};

type Asset = {
  sys: { id: string };
  fields?: {
    title?: string;
    description?: string;
    file?: { url?: string };
  };
};

interface Props {
  post: RenderPost;
  assetsById: Map<string, Asset>;
}

const { post, assetsById } = Astro.props as Props;

const thumbId = post.fields.thumbnail?.sys?.id;
const asset = thumbId ? assetsById.get(thumbId) : undefined;
const imgUrl = toAbsoluteContentfulUrl(asset?.fields?.file?.url);

const alt =
  asset?.fields?.description ||
  asset?.fields?.title ||
  post.fields.title ||
  'Render thumbnail';


const tags = (post.metadata.tags ?? []).map(t => t.sys.id).filter(Boolean);
const filterableTags = tags.filter(t => t !== 'renders');

const title = post.fields.title ?? 'Untitled render';
const fileSize = post.fields.fileSize ?? '';
const downloadUrl = post.fields.downloadUrl ?? '#';
const publishDate = post.fields.date ?? '';
const dimensions = post.fields.imageDimensions ?? '';

// Split on the first ": " only
const splitTitle = (t: string) => {
  const idx = t.indexOf(': ');
  if (idx === -1) return { prefix: '', rest: t };
  return {
    prefix: t.slice(0, idx + 2), // includes ": "
    rest: t.slice(idx + 2),
  };
};

const { prefix, rest } = splitTitle(title);

function toAbsoluteContentfulUrl(url?: string) {
  if (!url) return '';
  return url.startsWith('//') ? `https:${url}` : url;
}

function formatUkDate(iso?: string) {
  if (!iso) return '';
  const t = Date.parse(iso);
  if (!Number.isFinite(t)) return '';
  return new Date(t).toLocaleDateString('en-GB'); // e.g. 26/11/2023
}

const publishDateUk = formatUkDate(publishDate);
---

<article
  class="render-card Card Card--hover Render"
  data-tags={filterableTags.join(' ')}
>
  <div class="Card-media Render-media">
    {imgUrl ? (
      <img
        src={imgUrl}
        alt={alt}
        loading="lazy"
        decoding="async"
        class="Render-img"
      />
    ) : (
      <div class="Render-empty">
        No thumbnail
      </div>
    )}
  </div>

  <div class="Render-body">
    <h3 class="Card-title Render-title">
      {prefix ? (
        <>
          <span class="Kicker Render-kicker">{prefix.replace(/:\s*$/, '')}</span>
          <span>{rest}</span>
        </>
      ) : (
        <span>{rest}</span>
      )}
    </h3>

    <dl class="Card-meta Render-meta">
      {publishDateUk ? (<><dt>Published</dt><dd>{publishDateUk}</dd></>) : null}
      {dimensions ? (<><dt>Dimensions</dt><dd>{dimensions}</dd></>) : null}
      {fileSize ? (<><dt>File size</dt><dd>{fileSize}</dd></>) : null}
    </dl>

    <a
      href={downloadUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-render-download
      data-render-title={title}
      class="Btn Btn--small Render-download"
    >
      Download
      <Icon name="newTab" title="Opens url in a new tab" size="small" />
    </a>
  </div>
</article>

<script is:inline>
  document.querySelectorAll('[data-render-download]').forEach(link => {
    if (link.dataset.gaBound === '1') return;
    link.dataset.gaBound = '1';

    link.addEventListener('click', () => {
      const title = link.getAttribute('data-render-title') || '';

      if (typeof window.gtag === 'function') {
        window.gtag('event', 'render_download_click', {
          render_title: title,
          location: 'renders_page'
        });
      }
    });
  });
</script>

<style>
.Render {
  padding: .75rem;
}

.Render-media {
  background-image: radial-gradient(ellipse at 50% 100%, rgba(123, 92, 255, .3), transparent 70%);
}

/* Keep the render's own proportions rather than filling the frame */
.Render-img {
  height: auto;
}

.Render-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 16 / 10;
  font-size: .875rem;
  line-height: calc(1.25 / .875);
  color: rgba(201, 184, 255, .6);
}

.Render-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 1.25rem 1rem .75rem;
}

.Render-title {
  font-size: 1.45rem;
  text-align: center;
}

.Render-kicker {
  justify-content: center;
  margin-bottom: .25rem;
}

.Render-meta {
  flex: 1;
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid rgba(201, 184, 255, .2);
}

.Render-download {
  width: 100%;
  margin-top: 1.25rem;
}
</style>
