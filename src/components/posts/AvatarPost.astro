---
interface Props {
  img: object;
  index: string;
  category: string;
  id: number;
  tags: string;
  section: number;
}

const { img, index, category, id, tags, section } = Astro.props;

const isCompact = section === 100;
const isXL = section === 400;

const wrapperClasses = `
  overflow-hidden
  border border-white/10
  bg-white/5
  backdrop-blur-md
  ${isCompact ? 'flex items-center rounded-r-xl' : 'rounded-b-xl'}
`;
---

<article
  class="avatar-card"
  data-post-id={id}
  data-tags={tags}
>
  <div class:list={[
    'wrapper-item Avatar',
    isCompact ? 'flex items-center' : 'flex flex-col',
  ]}>
    {img ? (
      <img
        src={img.url}
        alt={img.alt}
        loading="lazy"
        decoding="async"
        class="Avatar-img block shrink-0 object-cover"
        style={`width: ${section}px; height: ${section}px;`}
        width={img.width}
        height={img.height}
      />
    ) : (
      <div class="Avatar-img aspect-square grid place-items-center text-lavender/60 text-sm" style={`width: ${section}px;`}>
        No image
      </div>
    )}

    <div class:list={['Avatar-label p-2', { 'text-center': !isCompact }]}>
      <strong>{index}</strong>{category ? <span class="text-lavender/80"> · {category}</span> : null}
    </div>
  </div>
</article>

<style>
.Avatar {
  padding: 4px;
  color: #ddd6f7;
  background: linear-gradient(180deg, rgba(24, 18, 58, .96), rgba(8, 6, 24, .98));
  border: 1px solid rgba(201, 184, 255, .3);
  box-shadow: 0 6px 18px rgba(27, 24, 48, .2);
  transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
}

.Avatar:hover {
  transform: translateY(-3px);
  border-color: rgba(201, 184, 255, .7);
  box-shadow: 0 0 24px rgba(167, 139, 255, .45);
}

.Avatar-img {
  border: 1px solid rgba(201, 184, 255, .2);
}

.Avatar-label {
  font-size: .8rem;
  line-height: 1.4;
}

.Avatar-label strong {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 600;
  color: #fff;
}
</style>
