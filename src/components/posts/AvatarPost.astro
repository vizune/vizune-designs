---
interface Props {
  img: object;
  index: string;
  category: string;
  id: number;
  tags: string;
  section: number;
}

const { img, index, category, id, tags, section } = Astro.props;

const isCompact = section === 100;
---

<article
  class="avatar-card"
  data-post-id={id}
  data-tags={tags}
>
  <div class:list={[
    'wrapper-item Avatar',
    isCompact ? 'Avatar--compact' : 'Avatar--stacked',
  ]}>
    {img ? (
      <img
        src={img.url}
        alt={img.alt}
        loading="lazy"
        decoding="async"
        class="Avatar-img"
        style={`width: ${section}px; height: ${section}px;`}
        width={img.width}
        height={img.height}
      />
    ) : (
      <div class="Avatar-img Avatar-empty" style={`width: ${section}px;`}>
        No image
      </div>
    )}

    <div class:list={['Avatar-label', { 'Avatar-label--center': !isCompact }]}>
      <strong>{index}</strong>{category ? <span class="Avatar-category"> · {category}</span> : null}
    </div>
  </div>
</article>

<style>
.Avatar {
  display: flex;
  padding: 4px;
  color: #ddd6f7;
  background: linear-gradient(180deg, rgba(24, 18, 58, .96), rgba(8, 6, 24, .98));
  border: 1px solid rgba(201, 184, 255, .3);
  box-shadow: 0 6px 18px rgba(27, 24, 48, .2);
  transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
}

.Avatar:hover {
  transform: translateY(-3px);
  border-color: rgba(201, 184, 255, .7);
  box-shadow: 0 0 24px rgba(167, 139, 255, .45);
}

.Avatar--compact {
  align-items: center;
}

.Avatar--stacked {
  flex-direction: column;
}

.Avatar-img {
  border: 1px solid rgba(201, 184, 255, .2);
}

img.Avatar-img {
  display: block;
  flex-shrink: 0;
  object-fit: cover;
}

.Avatar-empty {
  display: grid;
  place-items: center;
  aspect-ratio: 1;
  font-size: .875rem;
  line-height: calc(1.25 / .875);
  color: rgba(201, 184, 255, .6);
}

.Avatar-label {
  padding: .5rem;
  font-size: .8rem;
  line-height: 1.4;
}

.Avatar-label--center {
  text-align: center;
}

.Avatar-category {
  color: rgba(201, 184, 255, .8);
}

.Avatar-label strong {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 600;
  color: #fff;
}
</style>
