---
import Sparkle from '@/components/ornament/Sparkle.astro';

type TutorialPost = {
  sys: { id: string };
  fields: {
    title?: string;
    slug?: string;
    publishDate?: string;
    description?: string;
    thumbnail?: { sys?: { id?: string } };
  };
};

type Asset = {
  sys: { id: string };
  fields?: {
    title?: string;
    description?: string;
    file?: { url?: string };
  };
};

interface Props {
  post: TutorialPost;
  assetsById: Map<string, Asset>;
}

const { post, assetsById } = Astro.props as Props;

function toAbsoluteContentfulUrl(url?: string) {
  if (!url) return '';
  return url.startsWith('//') ? `https:${url}` : url;
}

function formatUkDate(iso?: string) {
  if (!iso) return '';
  const t = Date.parse(iso);
  if (!Number.isFinite(t)) return '';
  return new Date(t).toLocaleDateString('en-GB');
}

const thumbId = post.fields.thumbnail?.sys?.id;
const asset = thumbId ? assetsById.get(thumbId) : undefined;
const imgUrl = toAbsoluteContentfulUrl(asset?.fields?.file?.url);

const title = post.fields.title ?? 'Untitled tutorial';
const slug = post.fields.slug ?? '';
const description = post.fields.description ?? '';
const publishDate = formatUkDate(post.fields.publishDate);

const alt =
  asset?.fields?.description ||
  asset?.fields?.title ||
  title ||
  'Tutorial thumbnail';

const trackingId = `tutorial-card-${post.sys.id}`;
---

<a
  id={trackingId}
  href={`/tutorials/${slug}/`}
  data-tutorial-click
  data-tutorial-title={title}
  data-tutorial-slug={slug}
  class="tutorial-card Card Card--hover Post Post--list"
>
  <div class="Card-media Post-media">
    {imgUrl ? (
      <img
        src={imgUrl}
        alt={alt}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="Post-empty">
        No thumbnail
      </div>
    )}
  </div>

  <div class="Post-body">
    <p class="Kicker">
      <Sparkle class="Kicker-star" />
      Tutorial
      {publishDate && <span class="Post-date">· {publishDate}</span>}
    </p>

    <h2 class="Card-title Post-title Post-title--small">
      {title}
    </h2>

    {description ? <p class="Card-text Post-text Post-text--clamp">{description}</p> : null}

    <span class="Card-more Post-more">Read tutorial <span aria-hidden="true">›</span></span>
  </div>
</a>

<script is:inline define:vars={{ trackingId }}>
  const link = document.getElementById(trackingId);

  if (link && link.dataset.gaBound !== '1') {
    link.dataset.gaBound = '1';

    link.addEventListener('click', () => {
      const title = link.getAttribute('data-tutorial-title') || '';
      const slug = link.getAttribute('data-tutorial-slug') || '';

      if (typeof window.gtag === 'function') {
        window.gtag('event', 'tutorial_click', {
          tutorial_title: title,
          tutorial_slug: slug,
          location: 'tutorials_page',
        });
      }
    });
  }
</script>

<style>
.Post {
  padding: .75rem;
}

@media (min-width: 640px) {
  .Post--list {
    display: grid;
    grid-template-columns: 170px 1fr;
  }
}

.Post-media {
  aspect-ratio: 1;
}

.Post-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: .875rem;
  line-height: calc(1.25 / .875);
  color: rgba(201, 184, 255, .6);
}

.Post-body {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 1.25rem 1rem .5rem;
}

@media (min-width: 640px) {
  .Post-body {
    padding: .75rem 1.25rem;
  }
}

.Post-date {
  color: rgba(201, 184, 255, .7);
  letter-spacing: .16em;
}

.Post-title {
  margin-top: .5rem;
}

.Post-title--small {
  font-size: 1.45rem;
}

.Post-text {
  margin-top: .75rem;
}

.Post-text--clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}

.Post-more {
  margin-top: 1rem;
}
</style>
