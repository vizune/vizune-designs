---
import Sparkle from '@/components/ornament/Sparkle.astro';

type TutorialPost = {
  sys: { id: string };
  fields: {
    title?: string;
    slug?: string;
    publishDate?: string;
    description?: string;
    thumbnail?: { sys?: { id?: string } };
  };
};

type Asset = {
  sys: { id: string };
  fields?: {
    title?: string;
    description?: string;
    file?: { url?: string };
  };
};

interface Props {
  post: TutorialPost;
  assetsById: Map<string, Asset>;
}

const { post, assetsById } = Astro.props as Props;

function toAbsoluteContentfulUrl(url?: string) {
  if (!url) return '';
  return url.startsWith('//') ? `https:${url}` : url;
}

function formatUkDate(iso?: string) {
  if (!iso) return '';
  const t = Date.parse(iso);
  if (!Number.isFinite(t)) return '';
  return new Date(t).toLocaleDateString('en-GB');
}

const thumbId = post.fields.thumbnail?.sys?.id;
const asset = thumbId ? assetsById.get(thumbId) : undefined;
const imgUrl = toAbsoluteContentfulUrl(asset?.fields?.file?.url);

const title = post.fields.title ?? 'Untitled tutorial';
const slug = post.fields.slug ?? '';
const description = post.fields.description ?? '';
const publishDate = formatUkDate(post.fields.publishDate);

const alt =
  asset?.fields?.description ||
  asset?.fields?.title ||
  title ||
  'Tutorial thumbnail';

const trackingId = `tutorial-card-${post.sys.id}`;
---

<a
  id={trackingId}
  href={`/tutorials/${slug}/`}
  data-tutorial-click
  data-tutorial-title={title}
  data-tutorial-slug={slug}
  class="tutorial-card Card Card--hover p-3 sm:grid sm:grid-cols-[170px_1fr]"
>
  <div class="Card-media aspect-square">
    {imgUrl ? (
      <img
        src={imgUrl}
        alt={alt}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="h-full w-full flex items-center justify-center text-sm text-lavender/60">
        No thumbnail
      </div>
    )}
  </div>

  <div class="flex flex-col justify-center px-4 pt-5 pb-2 sm:px-5 sm:py-3">
    <p class="Kicker">
      <Sparkle class="Kicker-star" />
      Tutorial
      {publishDate && <span class="text-lavender/70 tracking-[.16em]">· {publishDate}</span>}
    </p>

    <h2 class="Card-title mt-2 text-[1.45rem]">
      {title}
    </h2>

    {description ? <p class="Card-text mt-3 line-clamp-3">{description}</p> : null}

    <span class="Card-more mt-4">Read tutorial <span aria-hidden="true">›</span></span>
  </div>
</a>

<script is:inline define:vars={{ trackingId }}>
  const link = document.getElementById(trackingId);

  if (link && link.dataset.gaBound !== '1') {
    link.dataset.gaBound = '1';

    link.addEventListener('click', () => {
      const title = link.getAttribute('data-tutorial-title') || '';
      const slug = link.getAttribute('data-tutorial-slug') || '';

      if (typeof window.gtag === 'function') {
        window.gtag('event', 'tutorial_click', {
          tutorial_title: title,
          tutorial_slug: slug,
          location: 'tutorials_page',
        });
      }
    });
  }
</script>
