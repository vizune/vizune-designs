---
/**
 * Remark42 comments, shared with Vizune Reviews' comments server
 * (site ID "design" keeps these comments separate from the reviews).
 * Shows "coming soon" until PUBLIC_REMARK42_HOST is set.
 *
 * Usage: <Comments path={`/blog/${slug}/`} />
 */
interface Props {
  /** Page path, used to give each post its own comment thread */
  path: string;
}

const { path } = Astro.props;
const host = import.meta.env.PUBLIC_REMARK42_HOST?.replace(/\/$/, '');
const siteId = import.meta.env.PUBLIC_REMARK42_SITE_ID || 'design';
// A fixed public origin keeps one thread per post, even when testing locally
const origin = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '');
---

<section class="Comments" id="comments" aria-labelledby="comments-title">
  <h2 class="PanelHeading" id="comments-title">Comments</h2>
  {
    host ? (
      <div class="Comments-status" id="comments-status" role="status" aria-live="polite" hidden>
        <span class="Comments-spinner" aria-hidden="true" />
        <span class="Comments-statusText">Loading comments…</span>
      </div>
      <div id="remark42" data-host={host} data-site-id={siteId} data-origin={origin} data-path={path}>
        <noscript>Comments need JavaScript turned on.</noscript>
      </div>
    ) : (
      <p class="Comments-soon">Comments are coming soon.</p>
    )
  }
</section>

<script>
  const el = document.getElementById('remark42');
  if (el) {
    const { host, siteId, origin, path } = el.dataset;

    // Loading state: spinner until the widget appears, a message if it never does.
    // It starts hidden in the HTML so visitors without JavaScript don't see an endless spinner.
    const status = document.getElementById('comments-status');
    const statusText = status?.querySelector('.Comments-statusText');
    let loaded = false;
    const showLoaded = () => {
      if (loaded) return;
      loaded = true;
      clearTimeout(slowTimer);
      observer.disconnect();
      if (status) status.hidden = true;
    };
    const showFailed = () => {
      if (loaded || !status || !statusText) return;
      status.classList.add('is-failed');
      statusText.textContent = "Comments couldn't load right now. Please refresh the page to try again.";
    };
    if (status) status.hidden = false;
    // Give a slow comments server a fair chance before saying anything's wrong
    const slowTimer = setTimeout(showFailed, 20000);

    // Remark42 adds an iframe and messages the page once the widget has drawn itself
    const watchIframe = (iframe: HTMLIFrameElement) => iframe.addEventListener('load', showLoaded, { once: true });
    const observer = new MutationObserver(() => {
      const iframe = el.querySelector('iframe');
      if (iframe) watchIframe(iframe);
    });
    observer.observe(el, { childList: true, subtree: true });
    window.addEventListener('message', (event) => {
      if (host && event.origin === new URL(host).origin) showLoaded();
    });
    const config = {
      host,
      site_id: siteId,
      url: (origin || location.origin) + path,
      components: ['embed'],
      // The post sits on the light panel
      theme: 'light',
      locale: 'en',
      show_email_subscription: false,
      no_footer: true,
      // Widget colours, matched to the site palette. Named colours are "r, g, b".
      // (Older name for Remark42's custom_properties option; works on every version.)
      __colors__: {
        '--primary-color': '75, 58, 168', // --purple: links, buttons, highlights
        '--primary-brighter-color': '123, 92, 255', // --violet: hover
        '--primary-darker-color': '36, 4, 112', // --indigo
        '--primary-text-color': '27, 24, 48', // --ink: comment text
        '--secondary-text-color': '74, 69, 102', // dates, meta text
        '--primary-background-color': '255, 255, 255', // comment box
        '--line-color': 'rgba(75, 58, 168, 0.2)', // dividers
        '--line-brighter-color': 'rgba(75, 58, 168, 0.35)',
        '--font-family': "'Mulish', system-ui, sans-serif",
      },
    };
    (window as unknown as { remark_config: typeof config }).remark_config = config;

    // Official Remark42 loader: module build for modern browsers, legacy fallback otherwise
    for (const component of config.components) {
      const script = document.createElement('script');
      const modern = 'noModule' in script;
      if (modern) script.type = 'module';
      else script.async = true;
      script.defer = true;
      script.src = `${host}/web/${component}${modern ? '.mjs' : '.js'}`;
      script.addEventListener('error', showFailed);
      (document.head || document.body).appendChild(script);
    }
  }
</script>

<style>
  .Comments {
    max-width: 40rem;
    margin: 3.5rem auto 0;
    scroll-margin-top: 2rem;
  }

  .Comments-status {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2.5rem 1rem;
    color: #4a4566;
    text-align: center;
  }

  .Comments-status[hidden] {
    display: none;
  }

  .Comments-spinner {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 3px solid rgba(75, 58, 168, 0.2);
    border-top-color: rgb(75, 58, 168);
    animation: comments-spin 0.8s linear infinite;
  }

  .Comments-status.is-failed .Comments-spinner {
    display: none;
  }

  @keyframes comments-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .Comments-spinner {
      animation-duration: 2.4s;
    }
  }

  .Comments-soon {
    text-align: center;
    color: #4a4566;
  }
</style>
