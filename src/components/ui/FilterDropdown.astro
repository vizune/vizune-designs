---
interface Props {
  value?: string;
  disabled?: boolean;
  label?: string;
}

const {
  value = '',
  disabled = false,
  label = 'Filter',
} = Astro.props;
---

<div class="flex flex-wrap gap-3 justify-center items-center">
  <div class="relative w-full md:w-80">
    <select class="Field" value={value} disabled={disabled} aria-label={label}>
      <slot />
    </select>
    <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-purple">
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.24 4.38a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
      </svg>
    </span>
  </div>

  <button type="button" data-clear-filter class="Btn Btn--small h-12">
    Clear filter
  </button>
</div>
