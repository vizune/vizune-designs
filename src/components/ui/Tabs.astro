---

---

<ui-tabs class="tabs block">
  <slot />
</ui-tabs>

<script is:inline>
  if (!customElements.get('ui-tabs')) {
    class UITabs extends HTMLElement {
      connectedCallback() {
        const tabsEls = Array.from(this.querySelectorAll('ui-tab'));
        const panels = Array.from(this.querySelectorAll('ui-panel'));
        if (!tabsEls.length || tabsEls.length !== panels.length) return;

        // Build/ensure tablist
        let tablist = this.querySelector('[role="tablist"]');
        if (!tablist) {
          tablist = document.createElement('div');
          tablist.setAttribute('role', 'tablist');
          tablist.setAttribute('aria-orientation', 'horizontal'); // a11y
          tablist.className = 'tablist flex items-center';
          this.prepend(tablist);
        }

        // Create real buttons from <ui-tab> content
        const buttons = tabsEls.map((src, i) => {
          const label = src.innerHTML.trim();
          const panelId = src.getAttribute('for') || `ui-panel-${i + 1}`;

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.id = `ui-tab-${i + 1}`; // ensure aria-labelledby works
          btn.className =
            'tab inline-flex items-center';
          btn.setAttribute('role', 'tab');
          btn.setAttribute('aria-controls', panelId);
          btn.setAttribute('aria-selected', String(i === 0));
          btn.setAttribute('tabindex', i === 0 ? '0' : '-1');
          btn.innerHTML = `<span>${label}</span>`;

          const li = document.createElement('div');
          li.className = 'flex justify-center';
          li.appendChild(btn);
          tablist.appendChild(li);

          src.remove();
          return btn;
        });

        panels.forEach((p, i) => {
          p.id = p.id || `ui-panel-${i + 1}`;
          p.setAttribute('role', 'tabpanel');
          p.setAttribute('aria-labelledby', buttons[i].id || '');
          p.hidden = i !== 0;
          p.classList.add('wrapper-item');
        });

        let current = 0;
        const activate = (idx) => {
          buttons.forEach((b, i) => {
            const on = i === idx;
            b.setAttribute('aria-selected', String(on));
            b.setAttribute('tabindex', on ? '0' : '-1');
            const panel = this.querySelector('#' + b.getAttribute('aria-controls'));
            if (panel) panel.hidden = !on;
          });
          current = idx;
          buttons[idx].focus({ preventScroll: true });
        };

        // Events
        buttons.forEach((b, i) => b.addEventListener('click', () => activate(i)));
        tablist.addEventListener('keydown', (e) => {
          if (!['ArrowLeft','ArrowRight','Home','End'].includes(e.key)) return;
          e.preventDefault();
          let next = current;
          if (e.key === 'ArrowLeft') next = (current - 1 + buttons.length) % buttons.length;
          if (e.key === 'ArrowRight') next = (current + 1) % buttons.length;
          if (e.key === 'Home') next = 0;
          if (e.key === 'End') next = buttons.length - 1;
          activate(next);
        });
      }
    }

    customElements.define('ui-tabs', UITabs);
    customElements.define('ui-tab', class extends HTMLElement {});
    customElements.define('ui-panel', class extends HTMLElement {});
  }
</script>

<style is:global>
ui-tabs {
  --ease: cubic-bezier(.2,.7,.2,1);
}

/* the tab bar: a row of ornamental pills over a fading rule */
ui-tabs .tablist {
  position: relative;
  flex-wrap: wrap;
  justify-content: center;
  gap: .75rem 1.25rem;
  width: 100%;
  padding: 0 0 1.5rem;
  margin-bottom: 1rem;
}

ui-tabs .tablist::after {
  content: "";
  position: absolute;
  left: 10%;
  right: 10%;
  bottom: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(75, 58, 168, .45), transparent);
}

/* each tab button */
ui-tabs [role="tab"] {
  -webkit-tap-highlight-color: transparent;
  height: auto;
  padding: .65rem 1.4rem;
  font-family: var(--font-display);
  font-size: 1.05rem;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--purple);
  background: rgba(255, 255, 255, .6);
  border: 1px solid rgba(75, 58, 168, .35);
  border-radius: 0;
  transition: color .2s var(--ease), background .2s var(--ease), box-shadow .2s var(--ease);
  cursor: pointer;
}

ui-tabs [role="tab"]:hover {
  color: var(--midnight);
  border-color: rgba(75, 58, 168, .6);
}

ui-tabs [role="tab"][aria-selected="true"] {
  color: #fff;
  background: linear-gradient(180deg, #1d1840, #07061a);
  border-color: rgba(201, 184, 255, .55);
  box-shadow: inset 0 0 0 3px #07061a, inset 0 0 0 4px rgba(201, 184, 255, .25), 0 6px 20px rgba(27, 24, 48, .3);
}

ui-tabs [role="tab"]:focus-visible {
  outline: 2px solid var(--violet);
  outline-offset: 3px;
}

@media (prefers-reduced-motion: reduce) {
  ui-tabs [role="tab"] { transition: none; }
}
</style>
