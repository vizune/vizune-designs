---
const GA_ID = import.meta.env.PUBLIC_GA_ID;
---

<div id="cookie-banner" class="Cookie hidden" role="region" aria-label="Cookie consent">
  <p class="Cookie-text">
    This site uses analytics cookies to understand how visitors use the site.<br />
    No personal data is stored. You can accept or decline.
  </p>

  <div class="flex justify-end gap-3">
    <button id="cookie-decline" type="button" class="Cookie-decline">Decline</button>
    <button id="cookie-accept" type="button" class="Btn Btn--small">Accept</button>
  </div>
</div>

<script is:inline define:vars={{ GA_ID }}>
  const banner = document.getElementById('cookie-banner');
  const acceptBtn = document.getElementById('cookie-accept');
  const declineBtn = document.getElementById('cookie-decline');

  const consent = localStorage.getItem('vizune-cookie-consent');

  function loadGA() {
    if (!GA_ID) return;

    const script1 = document.createElement('script');
    script1.async = true;
    script1.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
    document.head.appendChild(script1);

    const script2 = document.createElement('script');
    script2.innerHTML = `
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', '${GA_ID}', { anonymize_ip: true });
    `;
    document.head.appendChild(script2);
  }

  if (!consent) {
    banner?.classList.remove('hidden');
  }

  if (consent === 'accepted') {
    loadGA();
  }

  acceptBtn?.addEventListener('click', () => {
    localStorage.setItem('vizune-cookie-consent', 'accepted');
    banner?.remove();
    loadGA();
  });

  declineBtn?.addEventListener('click', () => {
    localStorage.setItem('vizune-cookie-consent', 'declined');
    banner?.remove();
  });
</script>

<style>
.Cookie {
  position: fixed;
  bottom: 1.5rem;
  left: 50%;
  z-index: 60;
  width: 90%;
  max-width: 36rem;
  padding: 1.25rem 1.5rem;
  transform: translateX(-50%);
  color: #ddd6f7;
  background: linear-gradient(180deg, rgba(22, 16, 54, .97), rgba(8, 6, 24, .98));
  border: 1px solid rgba(201, 184, 255, .45);
  box-shadow: inset 0 0 0 4px rgba(8, 6, 24, .9), inset 0 0 0 5px rgba(201, 184, 255, .15), 0 10px 40px rgba(0, 0, 0, .6);
}

.Cookie-text {
  margin-bottom: 1rem;
  font-size: .875rem;
  line-height: 1.65;
}

.Cookie-decline {
  padding: .6rem 1.15rem;
  font-family: var(--font-display);
  font-size: .9rem;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--lavender);
  border: 1px solid rgba(201, 184, 255, .3);
  transition: color .2s ease, border-color .2s ease;
}

.Cookie-decline:hover {
  color: #fff;
  border-color: var(--lavender);
}
</style>
