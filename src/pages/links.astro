---
import Layout from '@/layouts/Layout.astro';
import vizuneButton01 from '@/assets/buttons/vizune-button-01.png';
import vizuneButton02 from '@/assets/buttons/vizune-button-02.png';
import vizuneButton03 from '@/assets/buttons/vizune-button-03.png';
import darkPassionJpg     from '@/assets/buttons/dark-passion-gfx.jpg';
import dreamingArcadiaJpg from '@/assets/buttons/dreaming-arcadia.jpg';
import eccentricityPng       from '@/assets/buttons/eccentricity.png';
import fadedMorningGif from '@/assets/buttons/faded-morning.gif';
import kingdraPng     from '@/assets/buttons/kingdra.png';
import notsJpg      from '@/assets/buttons/numbers-of-the-sky.jpg';
import questionPointWebp        from '@/assets/buttons/question-point.webp';
import redVelvetGif     from '@/assets/buttons/red-velvet.gif';
import twilightPng     from '@/assets/buttons/twilight-pentagram.png';


const linkExchangeList = [
  {
    name: 'Dreamscape',
    url: 'http://dreamscape.ezyro.com',
  },
  {
    name: 'Mishipaper Graphics',
    url: 'https://mishipaper.tumblr.com/',
  },
  {
    name: 'Neotokio3TV',
    url: 'https://www.youtube.com/@Neotokio3TV/',
  },
];

const linkExchangeButtons = [
  {
    name: 'Dark Passion GFX',
    url: 'http://www.dp-gfx.de',
    image: darkPassionJpg,
  },
  {
    name: 'Dreaming Arcadia',
    url: 'https://dreaming--arcadia.com/',
    image: dreamingArcadiaJpg,
  },
  {
    name: 'Eccentricity',
    url: 'http://eccentricity.sammiirose.com/',
    image: eccentricityPng,
  },
  {
    name: 'Faded Morning',
    url: 'https://faded-morning.carrd.co/',
    image: fadedMorningGif,
  },
  {
    name: 'Kingdra',
    url: 'https://kingdra.net/',
    image: kingdraPng,
  },
  {
    name: 'Numbers of the Sky',
    url: 'https://numbersofthesky.tumblr.com/',
    image: notsJpg,
  },
  {
    name: 'Question Point',
    url: 'https://thequestpoint.wordpress.com/',
    image: questionPointWebp,
  },
  {
    name: 'Red Velvet',
    url: 'https://redvelvet.cc/',
    image: redVelvetGif,
  },
  {
    name: 'Twilight Pentagram',
    url: 'https://twilightpentagram.neocities.org/',
    image: twilightPng,
  },
];
---

<Layout
  title="Vizune Designs - Link Exchange"
  description="Link exchange and affiliate buttons for Vizune Designs."
  heading="Link Exchange"
  kicker="Kindred sites"
  intro="Buttons to link back to Vizune, and the sites I exchange links with."
>
  <section class="Prose">
    <h2>Vizune link buttons</h2>
    <p>
      Feel free to use one of my buttons if you would like to link back to Vizune. Please don't direct link and save to your own server.
    </p>

    <div class="LinkButtons">
      {[vizuneButton03, vizuneButton01, vizuneButton02].map((button, i) => (
        <span class="LinkButtons-item">
          <img
            src={button.src}
            alt={`Vizune link button version ${[3, 1, 2][i]}`}
            width="88"
            height="31"
            class="Pixelated"
          />
        </span>
      ))}
    </div>

    <h2>Link exchanges</h2>
    <p>
      If you would like your website link or button featured below, drop me a message in the chat box.
    </p>
  </section>

  <div class="Exchange">
    {linkExchangeButtons.map((button) => (
      <a
        href={button.url}
        title={button.name}
        target="_blank"
        rel="noopener noreferrer"
        class="Card Card--hover Exchange-card"
      >
        <span class="Exchange-button">
          <img
            src={button.image.src}
            alt={`${button.name} button`}
            width="88"
            height="31"
            class="Pixelated"
          />
        </span>
        <span class="Card-title Exchange-name">{button.name}</span>
      </a>
    ))}
  </div>

  <div class="Exchange-links">
    {linkExchangeList.map((link) => (
      <a
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        class="Btn Btn--small"
      >
        {link.name}
      </a>
    ))}
  </div>
</Layout>

<style>
  .Prose > .LinkButtons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  /* 88x31 buttons are pixel art, so keep their edges crisp */
  .Pixelated {
    image-rendering: pixelated;
  }

  .LinkButtons-item {
    display: flex;
    padding: 4px;
    background: linear-gradient(180deg, #1d1840, #07061a);
    border: 1px solid rgba(201, 184, 255, .55);
    box-shadow: inset 0 0 0 3px #07061a, 0 6px 20px rgba(27, 24, 48, .25);
  }

  .Exchange {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    max-width: 64rem;
    margin: 2rem auto 0;
  }

  @media (min-width: 640px) {
    .Exchange {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .Exchange {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .Exchange-card {
    align-items: center;
    padding: 1rem;
    text-align: center;
  }

  .Exchange-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 64px;
    background: #08061a;
    border: 1px solid rgba(201, 184, 255, .2);
  }

  .Exchange-name {
    margin-top: .75rem;
    font-size: 1.1rem;
  }

  .Exchange-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    max-width: 64rem;
    margin: 1.5rem auto 0;
  }
</style>
