---
import Layout from '@/layouts/Layout.astro';
import PostPagination from '@/components/ui/PostPagination.astro';
import {
  fetchContentfulEntries,
  richTextToHtml,
  type RichTextDocument,
  type ContentfulEntry,
} from '@/lib/contentful';

type BlogFields = {
  title?: string;
  slug?: string;
  banner?: {
    sys: {
      type: 'Link';
      linkType: 'Asset';
      id: string;
    };
  };
  publishDate?: string;
  description?: string;
  content?: RichTextDocument;
};

type PostLink = { title: string; url: string } | null;

export async function getStaticPaths() {
  const { items, assets } = await fetchContentfulEntries<BlogFields>('articles');
  const assetsById = Object.fromEntries(assets.map((asset) => [asset.sys.id, asset]));

  // Oldest first, so "previous" is the older post and "next" the newer one
  const toTime = (d?: string) => {
    const t = d ? Date.parse(d) : NaN;
    return Number.isFinite(t) ? t : -Infinity;
  };
  const posts = items
    .filter((item) => item.fields?.slug)
    .sort((a, b) => toTime(a.fields.publishDate) - toTime(b.fields.publishDate));

  const linkTo = (item?: ContentfulEntry<BlogFields>): PostLink =>
    item ? { title: item.fields.title ?? 'Blog post', url: `/blog/${item.fields.slug}/` } : null;

  return posts.map((item, i) => ({
    params: { slug: item.fields.slug! },
    props: {
      entry: item,
      assetsById,
      prev: linkTo(posts[i - 1]),
      next: linkTo(posts[i + 1]),
    },
  }));
}

const {
  entry,
  assetsById,
  prev,
  next,
} = Astro.props as {
  entry: ContentfulEntry<BlogFields>;
  assetsById: Record<string, unknown>;
  prev: PostLink;
  next: PostLink;
};

const title = entry.fields.title ?? 'Blog post';
const description = entry.fields.description ?? title;
const entryID = entry.sys.id;
const bannerId = entry.fields.banner?.sys.id;

const banner = bannerId
  ? (assetsById[bannerId] as {
      fields?: {
        file?: {
          url?: string;
        };
        title?: string;
        description?: string;
      };
    })
  : undefined;

const bannerUrl = banner?.fields?.file?.url
  ? `https:${banner.fields.file.url}`
  : undefined;

const bannerAlt =
  banner?.fields?.description ??
  banner?.fields?.title ??
  title;

const html = richTextToHtml(
  entry.fields.content,
  new Map(Object.entries(assetsById))
);

const pageUrl = Astro.url.href;

---

<Layout
  title={`Vizune Designs - ${title}`}
  description={description}
  heading={title}
  kicker="News & updates"
  intro={entry.fields.description}
  date={entry.fields.publishDate}
>
  <article class="home-article">
    {
      bannerUrl && (
        <figure class="ArticleBanner">
          <img src={bannerUrl} alt={bannerAlt} />
        </figure>
      )
    }

    <div class="Prose" set:html={html} />

    <PostPagination prev={prev} next={next} />

    <section class="Comments">
      <h2 class="PanelHeading">Comments</h2>
      <div id="disqus_thread"></div>
      <noscript>
        Please enable JavaScript to view the comments powered by Disqus.
      </noscript>
    </section>
  </article>

  <script is:inline define:vars={{ pageUrl, entryID }}>
    window.disqus_config = function () {
      this.page.url = pageUrl;
      this.page.identifier = entryID;
    };

    (() => {
      const d = document;
      const s = d.createElement('script');
      s.src = 'https://vizune.disqus.com/embed.js';
      s.setAttribute('data-timestamp', String(+new Date()));
      (d.head || d.body).appendChild(s);
    })();
  </script>
</Layout>

<style is:global>
  /* Banner framed like a picture on the panel */
  .ArticleBanner {
    max-width: 52rem;
    margin: 0 auto 3rem;
    padding: 5px;
    background: linear-gradient(180deg, #1d1840, #07061a);
    border: 1px solid rgba(201, 184, 255, .55);
    box-shadow: inset 0 0 0 4px #07061a, 0 18px 40px rgba(27, 24, 48, .3);
  }

  .ArticleBanner img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Keep the whole post (text and image rows) in one reading column */
  .home-article .Prose {
    max-width: 40rem;
    margin: 0 auto;
  }

  /* Inline images in posts sit side by side */
  .home-article .Prose .content-image {
    display: inline-block;
    max-width: 33%;
    margin: 2rem 0;
    vertical-align: top;
  }

  .Comments {
    max-width: 40rem;
    margin: 4rem auto 0;
  }
</style>
