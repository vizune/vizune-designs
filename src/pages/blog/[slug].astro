---
import Layout from '@/layouts/Layout.astro';
import BlogArticle from '@/components/blog/BlogArticle.astro';
import {
  fetchContentfulEntries,
  type RichTextDocument,
  type ContentfulEntry,
} from '@/lib/contentful';

type BlogFields = {
  title?: string;
  slug?: string;
  banner?: {
    sys: {
      type: 'Link';
      linkType: 'Asset';
      id: string;
    };
  };
  publishDate?: string;
  description?: string;
  content?: RichTextDocument;
};

type PostLink = { title: string; url: string } | null;

export async function getStaticPaths() {
  const { items, assets } = await fetchContentfulEntries<BlogFields>('articles');
  const assetsById = Object.fromEntries(assets.map((asset) => [asset.sys.id, asset]));

  // Oldest first, so "previous" is the older post and "next" the newer one
  const toTime = (d?: string) => {
    const t = d ? Date.parse(d) : NaN;
    return Number.isFinite(t) ? t : -Infinity;
  };
  const posts = items
    .filter((item) => item.fields?.slug)
    .sort((a, b) => toTime(a.fields.publishDate) - toTime(b.fields.publishDate));

  const linkTo = (item?: ContentfulEntry<BlogFields>): PostLink =>
    item ? { title: item.fields.title ?? 'Blog post', url: `/blog/${item.fields.slug}/` } : null;

  return posts.map((item, i) => ({
    params: { slug: item.fields.slug! },
    props: {
      entry: item,
      assetsById,
      prev: linkTo(posts[i - 1]),
      next: linkTo(posts[i + 1]),
    },
  }));
}

const {
  entry,
  assetsById,
  prev,
  next,
} = Astro.props as {
  entry: ContentfulEntry<BlogFields>;
  assetsById: Record<string, unknown>;
  prev: PostLink;
  next: PostLink;
};

const title = entry.fields.title ?? 'Blog post';
const description = entry.fields.description ?? title;
---

<Layout
  title={`Vizune Designs - ${title}`}
  description={description}
  heading={title}
  kicker="News & updates"
  intro={entry.fields.description}
  date={entry.fields.publishDate}
>
  <BlogArticle entry={entry} assetsById={assetsById} prev={prev} next={next} />
</Layout>
