---

<Layout
  title="Vizune Designs - Credits"
  description="Credits & Resources used by Vizune Designs."
  heading="Credits & Resources"
  kicker="Thank you"
  intro="Everything I use to make Vizune a reality, and the artists and creators whose resources I have used."
>
  <section class="Prose">
    <h2>Vizune tech stack</h2>

    <ul>
      {techStack.map((link) => (
        <li>
          <span>{ link.description }</span> <a href={link.url} target="_blank" rel="noopener noreferrer">{link.name}</a>
          {link.name2 && link.url2 && (<span>and <a href={link.url2} target="_blank" rel="noopener noreferrer">{link.name2}</a></span>)}
        </li>
      ))}
    </ul>

    <h2>Image credits</h2>
    <div class="CreditGrid">
      {imageSources.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="CreditChip"
        >
          {link.name}
        </a>
      ))}
    </div>

    <h2>Design credits</h2>
    <div class="CreditGrid">
      {designSources.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="CreditChip"
        >
          {link.name}
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  /* Credit names as small ornamental tags on the light panel */
  .Prose > .CreditGrid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .6rem;
    max-width: 52rem;
    margin-bottom: 2.5rem;
  }

  .Prose .CreditChip {
    padding: .4rem .9rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
    text-decoration: none;
    background: rgba(255, 255, 255, .65);
    border: 1px solid rgba(75, 58, 168, .3);
    transition: color .2s ease, border-color .2s ease, box-shadow .2s ease, transform .2s ease;
  }

  .Prose .CreditChip:hover {
    color: var(--purple);
    border-color: var(--violet);
    box-shadow: 0 0 14px rgba(123, 92, 255, .25);
    transform: translateY(-2px);
  }
</style>
