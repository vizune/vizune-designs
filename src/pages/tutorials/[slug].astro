---
import Layout from '@/layouts/Layout.astro';
import PostPagination from '@/components/ui/PostPagination.astro';
import {
  fetchContentfulEntries,
  richTextToHtml,
  type RichTextDocument,
  type ContentfulEntry,
} from '@/lib/contentful';

type TutorialFields = {
  title?: string;
  slug?: string;
  publishDate?: string;
  description?: string;
  content?: RichTextDocument;
  demoUrl: string;
};

type PostLink = { title: string; url: string } | null;

export async function getStaticPaths() {
  const { items, assets } = await fetchContentfulEntries<TutorialFields>('tutorials');
  const assetsById = Object.fromEntries(assets.map((asset) => [asset.sys.id, asset]));

  // Oldest first, so "previous" is the older tutorial and "next" the newer one
  const toTime = (d?: string) => {
    const t = d ? Date.parse(d) : NaN;
    return Number.isFinite(t) ? t : -Infinity;
  };
  const tutorials = items
    .filter((item) => item.fields?.slug)
    .sort((a, b) => toTime(a.fields.publishDate) - toTime(b.fields.publishDate));

  const linkTo = (item?: ContentfulEntry<TutorialFields>): PostLink =>
    item ? { title: item.fields.title ?? 'Tutorial', url: `/tutorials/${item.fields.slug}/` } : null;

  return tutorials.map((item, i) => ({
    params: { slug: item.fields.slug! },
    props: {
      entry: item,
      assetsById,
      prev: linkTo(tutorials[i - 1]),
      next: linkTo(tutorials[i + 1]),
    },
  }));
}

const {
  entry,
  assetsById,
  prev,
  next,
} = Astro.props as {
  entry: ContentfulEntry<TutorialFields>;
  assetsById: Record<string, unknown>;
  prev: PostLink;
  next: PostLink;
};

const title = entry.fields.title ?? 'Tutorial';
const demoUrl = entry.fields.demoUrl;
const html = richTextToHtml(
  entry.fields.content,
  new Map(Object.entries(assetsById))
);
---

<Layout
  title={`Vizune Designs - ${title}`}
  description={entry.fields.description ?? title}
  heading={title}
  kicker="Tutorial"
  intro={entry.fields.description}
  date={entry.fields.publishDate}
>
  <article>
    {demoUrl ? (
      <p class="text-center mb-10">
        <a href={demoUrl} target="_blank" rel="noopener noreferrer" class="Btn">
          View the demo <span aria-hidden="true">›</span>
        </a>
      </p>
    ) : null}

    <div class="Prose" set:html={html}></div>

    <PostPagination prev={prev} next={next} prevLabel="Previous tutorial" nextLabel="Next tutorial" />
  </article>
</Layout>
