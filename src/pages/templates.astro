---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/Icon.astro';
import TemplateTarotCard from '@/components/posts/TemplatePost.astro';
import arrowPng from '@/assets/arrow.png';

type Tag = { sys: { id: string } };

type TemplatePost = {
  metadata: { tags?: Tag[] };
  sys: { id: string };
  fields: {
    title?: string;
    slug?: string;
    banner?: { sys?: { id?: string } };
    downloadUrl?: string;
    fileSize?: string;
    publishDate?: string;
    techStack?: string;
    category?: string;
    series?: string;
    character?: string;
    demoUrl?: string;
    repoUrl?: string;
  };
};

type Asset = {
  sys: { id: string };
  fields?: { file?: { url?: string }; title?: string; description?: string };
};

const data = await fetch(import.meta.env.PUBLIC_POSTS_TEMPLATES).then((r) => r.json());
const items: TemplatePost[] = (data?.items ?? []) as TemplatePost[];
const assets: Asset[] = (data?.includes?.Asset ?? []) as Asset[];
const assetsById = new Map<string, Asset>(assets.map((a) => [a.sys.id, a]));

const toTime = (d?: string) =>
  d && Number.isFinite(Date.parse(d)) ? Date.parse(d) : -Infinity;

const sorted = [...items].sort(
  (a, b) => toTime(b.fields.publishDate) - toTime(a.fields.publishDate)
);
---

<Layout
  title="Vizune Designs - Templates"
  heading="Vizune Templates"
  kicker="Designs"
  intro="Free website templates. Explore the spread and select a card to reveal its details."
  description="Free website templates from Vizune Designs."
>
  <section class="relative pb-4" data-tarot-root>
    <div class="relative mx-auto max-w-[54rem]">
      <div
        class="tarot-spread relative w-full h-[400px] sm:h-[440px] md:h-[500px]"
        data-spread
      >
        {sorted.map((post, idx) => (
          <TemplateTarotCard post={post} assetsById={assetsById} index={idx} />
        ))}
      </div>

      <button
        type="button"
        aria-label="Previous template"
        data-prev
        class="Spread-arrow Spread-arrow--prev Btn h-11 w-11 sm:h-14 sm:w-14 md:h-16 md:w-16 !p-0 rounded-full"
      >
        <img
          src={arrowPng.src}
          alt=""
          aria-hidden="true"
          class="w-[32px] h-[21px] rotate-180"
        />
      </button>

      <button
        type="button"
        aria-label="Next template"
        data-next
        class="Spread-arrow Spread-arrow--next Btn h-11 w-11 sm:h-14 sm:w-14 md:h-16 md:w-16 !p-0 rounded-full"
      >
        <img
          src={arrowPng.src}
          alt=""
          aria-hidden="true"
          class="w-[32px] h-[21px]"
        />
      </button>
    </div>

    <!-- The "reading" for the centre card -->
    <div class="Reading" data-template-details aria-live="polite">
      <span class="Reading-ornament" aria-hidden="true"></span>
      <p class="Reading-kicker" data-template-kicker></p>
      <h2 class="Reading-title" data-template-title></h2>
      <dl class="Reading-meta" data-template-meta></dl>
      <div class="Reading-links" data-template-links></div>
    </div>

    <template data-new-tab-icon>
      <Icon name="newTab" title="Opens url in a new tab" size="small" />
    </template>

    <script is:inline>
      (() => {
        const root = document.querySelector('[data-tarot-root]');
        if (!root) return;

        const cards = Array.from(root.querySelectorAll('[data-card]'));
        const prevBtn = root.querySelector('[data-prev]');
        const nextBtn = root.querySelector('[data-next]');
        const details = root.querySelector('[data-template-details]');
        const kicker = root.querySelector('[data-template-kicker]');
        const title = root.querySelector('[data-template-title]');
        const meta = document.querySelector('[data-template-meta]');
        const links = document.querySelector('[data-template-links]');
        const newTabIcon = root.querySelector('[data-new-tab-icon]')?.innerHTML ?? '';

        if (!cards.length) return;

        let activeIndex = 0;
        let isAnimating = false;

        function formatUkDate(value) {
          if (!value) return '';
          const t = Date.parse(value);
          if (!Number.isFinite(t)) return value;
          return new Date(t).toLocaleDateString('en-GB');
        }

        function renderDetails(card) {
          if (!details || !meta || !links || !card) return;

          const publishDate = card.dataset.publishDate || '';
          const techStack = card.dataset.techStack || '';
          const category = card.dataset.category || '';
          const series = card.dataset.series || '';
          const character = card.dataset.character || '';
          const demoUrl = card.dataset.demoUrl || '';
          const repoUrl = card.dataset.repoUrl || '';
          const downloadUrl = card.dataset.downloadUrl || '';

          // Split "14: The Dusken Glow" into the card number and its name
          const fullTitle = card.dataset.title || '';
          const match = fullTitle.match(/^(\d+):\s*(.*)$/);

          if (kicker) kicker.textContent = match ? `Template ${match[1]}` : 'Template';
          if (title) title.textContent = match ? match[2] : fullTitle;

          const facts = [
            ['Published', formatUkDate(publishDate)],
            ['Tech stack', techStack],
            ['Category', category],
            ['Series', series],
            ['Character', character],
          ].filter(([, value]) => value);

          meta.innerHTML = facts.map(([label, value]) => `
            <div class="Reading-fact"><dt>${label}</dt><dd>${value}</dd></div>
          `).join('');

          const items = [
            demoUrl ? { label: 'Demo', href: demoUrl, action: 'demo' } : null,
            repoUrl ? { label: 'Source code', href: repoUrl, action: 'repo' } : null,
            downloadUrl ? { label: 'Download .zip', href: downloadUrl, action: 'download' } : null,
          ].filter(Boolean);

          links.innerHTML = items.map((item) => `
            <a
              href="${item.href}"
              target="_blank"
              rel="noopener noreferrer"
              data-template-action="${item.action}"
              class="Btn Btn--small"
            >
              <span>${item.label}</span>
              ${newTabIcon}
            </a>
          `).join('');

          links.querySelectorAll('[data-template-action]').forEach(link => {
            link.addEventListener('click', () => {
              const action = link.dataset.templateAction;
              const templateName = card.dataset.title || '';

              if (window.gtag) {
                gtag('event', 'template_click', {
                  template_name: templateName,
                  action: action,
                  location: 'templates_page'
                });
              }
            });
          });
        }

        // Fade the reading out, swap in the new card's details, then fade back in
        let shownCard = null;
        let fadeTimer = 0;

        function showDetails(card) {
          if (!card || card === shownCard) return;

          const first = shownCard === null;
          shownCard = card;

          if (first) {
            renderDetails(card);
            return;
          }

          details?.classList.add('is-fading');
          window.clearTimeout(fadeTimer);
          fadeTimer = window.setTimeout(() => {
            renderDetails(shownCard);
            details?.classList.remove('is-fading');
          }, 200);
        }

        function render() {
          cards.forEach((card, index) => {
            card.classList.remove('is-left', 'is-center', 'is-right', 'is-hidden');

            if (index === activeIndex - 1) {
              card.classList.add('is-left');
              return;
            }

            if (index === activeIndex) {
              card.classList.add('is-center');
              return;
            }

            if (index === activeIndex + 1) {
              card.classList.add('is-right');
              return;
            }

            card.classList.add('is-hidden');
          });

          const centerCard = cards[activeIndex] ?? null;
          showDetails(centerCard);

          if (prevBtn) prevBtn.disabled = isAnimating || activeIndex === 0;
          if (nextBtn) nextBtn.disabled = isAnimating || activeIndex === cards.length - 1;
        }

        function moveTo(nextIndex) {
          if (isAnimating) return;

          const clamped = Math.max(0, Math.min(cards.length - 1, nextIndex));
          if (clamped === activeIndex) return;

          isAnimating = true;
          activeIndex = clamped;
          render();

          window.setTimeout(() => {
            isAnimating = false;
            render();
          }, 450);
        }

        prevBtn?.addEventListener('click', () => moveTo(activeIndex - 1));
        nextBtn?.addEventListener('click', () => moveTo(activeIndex + 1));

        cards.forEach((card) => {
          card.addEventListener('click', () => {
            if (isAnimating) return;

            const index = Number(card.getAttribute('data-index') || 0);

            if (index === activeIndex - 1) {
              moveTo(activeIndex - 1);
            } else if (index === activeIndex + 1) {
              moveTo(activeIndex + 1);
            }
          });
        });

        render();
      })();
    </script>
  </section>
</Layout>

<style>
  .Spread-arrow {
    position: absolute;
    top: 50%;
    z-index: 5;
    transform: translateY(-50%);
  }

  .Spread-arrow:hover:not(:disabled) {
    transform: translateY(calc(-50% - 2px));
  }

  .Spread-arrow--prev { left: 0; }
  .Spread-arrow--next { right: 0; }

  .Reading {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 auto;
    text-align: center;
    transition: opacity .2s ease, transform .2s ease;
  }

  .Reading.is-fading {
    opacity: 0;
    transform: translateY(6px);
  }

  .Reading-ornament {
    width: 3.75rem;
    aspect-ratio: 436 / 210;
    margin-bottom: 1rem;
    background: var(--midnight);
    -webkit-mask: url('/divider-ornament.svg') center / contain no-repeat;
    mask: url('/divider-ornament.svg') center / contain no-repeat;
  }

  .Reading-kicker {
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--carmine);
  }

  .Reading-title {
    margin-top: .35rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.1;
    color: #1f1a4d;
    text-wrap: balance;
  }

  /* Facts on one line, separated by sparkles */
  .Reading-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .6rem 0;
    margin-top: 1.25rem;
    padding: .9rem 0;
    border-top: 1px solid rgba(75, 58, 168, .2);
    border-bottom: 1px solid rgba(75, 58, 168, .2);
  }

  .Reading-meta :global(.Reading-fact) {
    display: flex;
    flex-direction: column;
    padding: 0 1.1rem;
  }

  .Reading-meta :global(.Reading-fact + .Reading-fact) {
    position: relative;
  }

  .Reading-meta :global(.Reading-fact + .Reading-fact)::before {
    content: '\2726';
    position: absolute;
    left: -.3rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: .55rem;
    color: var(--violet);
  }

  .Reading-meta :global(dt) {
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--purple);
  }

  .Reading-meta :global(dd) {
    margin: .15rem 0 0;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
  }

  .Reading-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .75rem;
    margin-top: 1.5rem;
  }

  .Reading-links :global(svg) {
    width: .85rem;
    height: .85rem;
    color: var(--lavender);
  }
</style>
