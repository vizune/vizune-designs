---
import Layout from '@/layouts/Layout.astro';
import BlogArticle from '@/components/blog/BlogArticle.astro';
import {
  fetchContentfulEntries,
  type RichTextDocument,
} from '@/lib/contentful';

type BlogFields = {
  title?: string;
  slug?: string;
  banner?: { sys: { id: string } };
  publishDate?: string;
  description?: string;
  content?: RichTextDocument;
};

const { items, assets } = await fetchContentfulEntries<BlogFields>('articles');
const assetsById = Object.fromEntries(assets.map((asset) => [asset.sys.id, asset]));

const toTime = (d?: string) => {
  const t = d ? Date.parse(d) : NaN;
  return Number.isFinite(t) ? t : -Infinity;
};

// Newest first: the home page shows the latest post in full
const sorted = items
  .filter((item) => item.fields?.slug)
  .sort((a, b) => toTime(b.fields.publishDate) - toTime(a.fields.publishDate));

const latest = sorted[0];
const previous = sorted[1];
const prev = previous
  ? { title: previous.fields.title ?? 'Blog post', url: `/blog/${previous.fields.slug}/` }
  : null;
---

<Layout
  title="Welcome to Vizune Designs - News & Updates"
  description="Vizune is a creative hub where anime, gaming, design, and web development merge — explore tutorials, visuals, and resources to fuel your imagination."
  heading={latest?.fields.title ?? 'Welcome to Vizune Designs'}
  kicker="Latest news"
  intro={latest?.fields.description}
  date={latest?.fields.publishDate}
>
  {latest ? (
    <BlogArticle entry={latest} assetsById={assetsById} prev={prev}>
      <p class="text-center pt-6">
        <a href={`/blog/${latest.fields.slug}/#disqus_thread`} class="Btn Btn--small">Leave a comment <span aria-hidden="true">›</span></a>
        <a href="/blog/" class="Btn Btn--small ml-3">All posts <span aria-hidden="true">›</span></a>
      </p>
    </BlogArticle>
  ) : (
    <p class="PanelIntro">A creative hub where anime, gaming, design and web development merge.</p>
  )}
</Layout>
